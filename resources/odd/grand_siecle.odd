<?xml-model href="teipublisher_odds.xsd"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Grand Siècle
                    <desc>Processing models for the Grand Siècle corpus — French discourse on painting, late 16th to mid-17th century</desc>
                </title>
                <title type="short">Grand Siècle</title>
            </titleStmt>
            <publicationStmt>
                <publisher>Université de Lausanne - UNIL</publisher>
                <availability status="restricted">
                    <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
                        This work is licensed under a Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License (CC BY-NC-SA 4.0).
                    </licence>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Customization for the Grand Siècle project, inheriting from teipublisher.odd</p>
                <p>born digital</p>
            </sourceDesc>
        </fileDesc>
        <revisionDesc>
            <change when="2026-03-26">V1 — processing models for SegmOnto zones, choice/orig/reg, NER entities, foreign language handling</change>
            <change when="2026-02-26T16:30:32.217Z">Initial version</change>
        </revisionDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" source="teipublisher.odd">

                <!-- ============================================================
                     Suppress sourceDoc — not rendered, used only as IIIF data source
                     ============================================================ -->
                <elementSpec ident="sourceDoc" mode="change">
                    <model behaviour="omit"/>
                </elementSpec>

                <!-- ============================================================
                     Page break: rendered as label, pb-view view="page" handles splitting
                     ============================================================ -->
                <elementSpec ident="pb" mode="change">
                    <model output="print" behaviour="omit"/>
                    <model predicate="@corresp = preceding-sibling::pb[1]/@corresp" behaviour="omit">
                        <desc>Skip duplicate consecutive pb with same @corresp</desc>
                    </model>
                    <model behaviour="webcomponent" cssClass="tei-pb">
                        <desc>Emit pb-facs-link for IIIF viewer synchronization</desc>
                        <param name="name" value="'pb-facs-link'"/>
                        <param name="content" value="if (@n) then @n else replace(@corresp, '^#', '')"/>
                        <param name="emit" value="'transcription'"/>
                        <param name="subscribe" value="'transcription'"/>
                        <param name="order" value="count($get(.)/preceding::pb) + 1"/>
                        <param name="emit-on-load" value="'emit-on-load'"/>
                        <param name="facs" value="let $corresp := replace(@corresp, '^#', '') let $surface := root($parameters?root)//surface[@xml:id = $corresp] let $url := head($surface/graphic/@url)/string() let $parts := tokenize($url, '/') return if (count($parts) gt 4) then string-join(subsequence($parts, 1, count($parts) - 4), '/') else ''"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Main text block (SegmOnto MainZone)
                     ============================================================ -->
                <elementSpec ident="ab" mode="change">
                    <model predicate="@type='MainZone'" behaviour="block" cssClass="tei-ab-MainZone"/>
                    <model behaviour="paragraph"/>
                </elementSpec>

                <!-- ============================================================
                     Line break: respected in both diplomatic and modernized views
                     ============================================================ -->
                <elementSpec ident="lb" mode="change">
                    <model behaviour="break">
                        <param name="type" value="'line'"/>
                        <param name="label" value="@n"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Forme work: running titles and quire marks
                     ============================================================ -->
                <elementSpec ident="fw" mode="change">
                    <model predicate="@type='RunningTitleZone'" behaviour="block" cssClass="tei-fw-RunningTitleZone"/>
                    <model predicate="@type='QuireMarksZone'" behaviour="block" cssClass="tei-fw-QuireMarksZone"/>
                    <model predicate="ancestor::p or ancestor::ab" behaviour="inline"/>
                    <model behaviour="block"/>
                </elementSpec>

                <!-- ============================================================
                     Notes: marginal notes + register-overview support from base ODD
                     ============================================================ -->
                <elementSpec ident="note" mode="change">
                    <model predicate="$parameters?mode='register-overview' and $parameters?show-notes and text()" behaviour="block"/>
                    <model predicate="$parameters?mode='register-overview' and not($parameters?show-notes)" behaviour="omit"/>
                    <model predicate="@type='MarginTextZone'" behaviour="block" cssClass="tei-note-MarginTextZone"/>
                    <model predicate="parent::person or parent::place or parent::org" behaviour="paragraph"/>
                    <model predicate="$parameters?mode='toc' or ancestor::listAnnotation" behaviour="omit"/>
                    <model behaviour="note">
                        <param name="place" value="@place"/>
                        <param name="label" value="@n"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Foreign language passages
                     Suppress v1 trailing artifacts (have @corresp), display inline otherwise
                     ============================================================ -->
                <elementSpec ident="foreign" mode="change">
                    <model predicate="parent::ab and @corresp" behaviour="omit">
                        <desc>Suppress trailing foreign artifacts from v1 pipeline — these have @corresp pointing to zones</desc>
                    </model>
                    <model behaviour="inline" cssClass="tei-foreign">
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="tei-foreign" data-lang="{@xml:lang}">[[content]]</span>
                        </pb:template>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Choice: output both orig and reg, CSS controls visibility
                     pb-toggle-feature toggles class "mode" on pb-page:
                       - no class = diplomatic (show orig)
                       - class "mode" = modernized (show reg)
                     ============================================================ -->
                <elementSpec ident="choice" mode="change">
                    <model predicate="orig and reg" behaviour="pass-through">
                        <param name="orig" value="orig"/>
                        <param name="reg" value="reg"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="choice-orig">[[orig]]</span><span class="choice-reg">[[reg]]</span>
                        </pb:template>
                    </model>
                    <model predicate="sic and corr" behaviour="alternate">
                        <param name="default" value="corr[1]"/>
                        <param name="alternate" value="sic[1]"/>
                    </model>
                    <model predicate="abbr and expan" behaviour="alternate">
                        <param name="default" value="expan[1]"/>
                        <param name="alternate" value="abbr[1]"/>
                    </model>
                </elementSpec>

                <elementSpec ident="orig" mode="change">
                    <model behaviour="inline"/>
                </elementSpec>

                <elementSpec ident="reg" mode="change">
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Word-level annotation: transparent, data attributes for tooltip
                     ============================================================ -->
                <elementSpec ident="w" mode="change">
                    <model predicate="@lemma or @pos" behaviour="pass-through">
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="tei-w" data-lemma="{@lemma}" data-pos="{@pos}">[[content]]</span>
                        </pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Person names: highlighted, linked to register, confidence-filterable
                     Includes register-mode predicates from base ODD (elementSpec replaces parent)
                     ============================================================ -->
                <elementSpec ident="persName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="alternate" value="parent::person/note"/>
                        <param name="uri" value="$parameters?context-path || '/people/' || parent::person/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="persName">
                            <pb-popover>
                                <span slot="default">[[content]]</span>
                                <template slot="alternate">[[alternate]]</template>
                            </pb-popover>
                        </a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="parent::person" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-person">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <a href="people/[[ref]]" class="entity-person" data-cert="[[cert]]">[[content]]</a>
                        </pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="entity-person" data-cert="[[cert]]">[[content]]</span>
                        </pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Place names: highlighted, linked to register, confidence-filterable
                     ============================================================ -->
                <elementSpec ident="placeName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="alternate" value="parent::place/note"/>
                        <param name="uri" value="$parameters?context-path || '/places/' || parent::place/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="placeName context">
                            <pb-popover>
                                <span slot="default">[[content]]</span>
                                <template slot="alternate">[[alternate]]</template>
                            </pb-popover>
                        </a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="parent::place" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-place">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <a href="places/[[ref]]" class="entity-place" data-cert="[[cert]]">[[content]]</a>
                        </pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="entity-place" data-cert="[[cert]]">[[content]]</span>
                        </pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Organization names: highlighted, linked to register, confidence-filterable
                     ============================================================ -->
                <elementSpec ident="orgName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="alternate" value="parent::org/note"/>
                        <param name="uri" value="$parameters?context-path || '/organizations/' || parent::org/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="orgName context">
                            <pb-popover>
                                <span slot="default">[[content]]</span>
                                <template slot="alternate">[[alternate]]</template>
                            </pb-popover>
                        </a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="parent::org" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-org">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <a href="organizations/[[ref]]" class="entity-org" data-cert="[[cert]]">[[content]]</a>
                        </pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="entity-org" data-cert="[[cert]]">[[content]]</span>
                        </pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

            </schemaSpec>
        </body>
    </text>
</TEI>
