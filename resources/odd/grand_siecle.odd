<?xml-model href="teipublisher_odds.xsd"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:pb="http://teipublisher.com/1.0" xml:lang="en">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Grand Siècle
                    <desc>Processing models for the Grand Siècle corpus — French discourse on painting, late 16th to mid-17th century</desc>
                </title>
                <title type="short">Grand Siècle</title>
            </titleStmt>
            <publicationStmt>
                <publisher>Université de Lausanne - UNIL</publisher>
                <availability status="restricted">
                    <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
                        This work is licensed under a Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License (CC BY-NC-SA 4.0).
                    </licence>
                </availability>
            </publicationStmt>
            <sourceDesc>
                <p>Customization for the Grand Siècle project, inheriting from teipublisher.odd</p>
                <p>born digital</p>
            </sourceDesc>
        </fileDesc>
        <revisionDesc>
            <change when="2026-04-01">V2 support — add sentence (s), punctuation (pc) elementSpecs; enrich word (w) with data-msd and data-norm attributes</change>
            <change when="2026-03-26">V1 — processing models for SegmOnto zones, choice/orig/reg, NER entities, foreign language handling</change>
            <change when="2026-02-26T16:30:32.217Z">Initial version</change>
        </revisionDesc>
    </teiHeader>
    <text>
        <body>
            <schemaSpec start="TEI teiCorpus" source="teipublisher.odd">

                <!-- ============================================================
                     Suppress sourceDoc — not rendered, used only as IIIF data source
                     ============================================================ -->
                <elementSpec ident="sourceDoc" mode="change">
                    <model behaviour="omit"/>
                </elementSpec>

                <!-- ============================================================
                     Page break: rendered as label, pb-view view="page" handles splitting
                     ============================================================ -->
                <elementSpec ident="pb" mode="change">
                    <model output="print" behaviour="omit"/>
                    <model predicate="@corresp = preceding-sibling::pb[1]/@corresp" behaviour="omit">
                        <desc>Skip duplicate consecutive pb with same @corresp</desc>
                    </model>
                    <model behaviour="webcomponent" cssClass="tei-pb">
                        <desc>Emit pb-facs-link for IIIF viewer synchronization</desc>
                        <param name="name" value="'pb-facs-link'"/>
                        <param name="content" value="if (@n) then @n else replace(@corresp, '^#', '')"/>
                        <param name="emit" value="'transcription'"/>
                        <param name="subscribe" value="'transcription'"/>
                        <param name="order" value="count($get(.)/preceding::pb) + 1"/>
                        <param name="emit-on-load" value="'emit-on-load'"/>
                        <param name="facs" value="let $corresp := replace(@corresp, '^#', '') let $surface := root($parameters?root)//surface[@xml:id = $corresp] let $url := head($surface/graphic/@url)/string() let $parts := tokenize($url, '/') return if (count($parts) gt 4) then string-join(subsequence($parts, 1, count($parts) - 4), '/') else ''"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Main text block (SegmOnto MainZone)
                     ============================================================ -->
                <elementSpec ident="ab" mode="change">
                    <model predicate="@type='MainZone'" behaviour="block" cssClass="tei-ab-MainZone"/>
                    <model behaviour="paragraph"/>
                </elementSpec>

                <!-- ============================================================
                     Line break: respected in both diplomatic and modernized views
                     ============================================================ -->
                <elementSpec ident="lb" mode="change">
                    <model behaviour="break">
                        <param name="type" value="'line'"/>
                        <param name="label" value="@n"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Forme work: running titles and quire marks
                     ============================================================ -->
                <elementSpec ident="fw" mode="change">
                    <model predicate="@type='RunningTitleZone'" behaviour="block" cssClass="tei-fw-RunningTitleZone"/>
                    <model predicate="@type='QuireMarksZone'" behaviour="block" cssClass="tei-fw-QuireMarksZone"/>
                    <model predicate="ancestor::p or ancestor::ab" behaviour="inline"/>
                    <model behaviour="block"/>
                </elementSpec>

                <!-- ============================================================
                     Notes: marginal notes + register-overview support from base ODD
                     ============================================================ -->
                <elementSpec ident="note" mode="change">
                    <model predicate="$parameters?view='notes' and @type='MarginTextZone'" behaviour="listItem" cssClass="gs-note-item">
                        <param name="n" value="@n"/>
                    </model>
                    <model predicate="$parameters?view='notes'" behaviour="omit"/>
                    <model predicate="$parameters?mode='register-overview' and $parameters?show-notes and text()" behaviour="block"/>
                    <model predicate="$parameters?mode='register-overview' and not($parameters?show-notes)" behaviour="omit"/>
                    <model predicate="@type='MarginTextZone'" behaviour="block" cssClass="tei-note-MarginTextZone"/>
                    <model predicate="parent::person or parent::place or parent::org" behaviour="paragraph"/>
                    <model predicate="$parameters?mode='toc' or ancestor::listAnnotation" behaviour="omit"/>
                    <model behaviour="note">
                        <param name="place" value="@place"/>
                        <param name="label" value="@n"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Foreign language passages
                     Suppress v1 trailing artifacts (have @corresp), display inline otherwise
                     ============================================================ -->
                <elementSpec ident="foreign" mode="change">
                    <model predicate="parent::ab and @corresp" behaviour="omit">
                        <desc>Suppress trailing foreign artifacts from v1 pipeline — these have @corresp pointing to zones</desc>
                    </model>
                    <model behaviour="inline" cssClass="tei-foreign">
                        <param name="lang" value="string((@xml:lang, '')[1])"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="tei-foreign" data-lang="[[lang]]">[[content]]</span>
                        </pb:template>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Choice / orig / reg: both versions are emitted; CSS toggles
                     visibility via :host-context(.mode) inside pb-view shadow DOM.
                     pb-toggle-feature name="mode" sets/removes class .mode on pb-page.
                     ============================================================ -->
                <elementSpec ident="choice" mode="change">
                    <model predicate="orig and reg" behaviour="inline" cssClass="tei-choice"/>
                    <model predicate="sic and corr" behaviour="alternate">
                        <param name="default" value="corr[1]"/>
                        <param name="alternate" value="sic[1]"/>
                    </model>
                    <model predicate="abbr and expan" behaviour="alternate">
                        <param name="default" value="expan[1]"/>
                        <param name="alternate" value="abbr[1]"/>
                    </model>
                </elementSpec>

                <elementSpec ident="orig" mode="change">
                    <model behaviour="inline" cssClass="choice-orig"/>
                </elementSpec>

                <elementSpec ident="reg" mode="change">
                    <model behaviour="inline" cssClass="choice-reg"/>
                </elementSpec>

                <!-- ============================================================
                     Sentence: transparent inline wrapper
                     ============================================================ -->
                <elementSpec ident="s" mode="change">
                    <model behaviour="inline" cssClass="tei-s">
                        <param name="sid" value="string((@xml:id, '')[1])"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="tei-s" data-id="[[sid]]">[[content]]</span>
                        </pb:template>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     Punctuation character: inline, joins left when @join="left"
                     ============================================================ -->
                <elementSpec ident="pc" mode="change">
                    <model predicate="@join='left'" behaviour="inline" cssClass="tei-pc join-left">
                        <pb:template xmlns="" xml:space="preserve"><span class="tei-pc join-left">[[content]]</span></pb:template>
                    </model>
                    <model behaviour="inline" cssClass="tei-pc"/>
                </elementSpec>

                <!-- ============================================================
                     Word-level annotation: transparent, data attributes for tooltip
                     ============================================================ -->
                <elementSpec ident="w" mode="change">
                    <model predicate="@lemma or @pos" behaviour="pass-through">
                        <param name="lemma" value="string((@lemma, '')[1])"/>
                        <param name="pos" value="string((@pos, '')[1])"/>
                        <param name="msd" value="string((@msd, '')[1])"/>
                        <param name="norm" value="string((@norm, '')[1])"/>
                        <pb:template xmlns="" xml:space="preserve">
                            <span class="tei-w" data-lemma="[[lemma]]" data-pos="[[pos]]" data-msd="[[msd]]" data-norm="[[norm]]">[[content]]</span>
                        </pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Person names: highlighted, linked to register, confidence-filterable
                     Includes register-mode predicates from base ODD (elementSpec replaces parent)
                     ============================================================ -->
                <elementSpec ident="persName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="alternate" value="parent::person/note"/>
                        <param name="uri" value="$parameters?context-path || '/people/' || parent::person/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="persName">
                            <pb-popover>
                                <span slot="default">[[content]]</span>
                                <template slot="alternate">[[alternate]]</template>
                            </pb-popover>
                        </a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="parent::person" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-person">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><a href="people/[[ref]]" class="entity-person" data-cert="[[cert]]">[[content]]</a></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge person-badge"><pb-i18n key="entity.person">Personne</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
<a href="people/[[ref]]" class="entity-tooltip-link"><pb-i18n key="entity.view-record">Voir la fiche</pb-i18n> &#x2192;</a>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-person" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge person-badge"><pb-i18n key="entity.person">Personne</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Place names: highlighted, linked to register, confidence-filterable
                     ============================================================ -->
                <elementSpec ident="placeName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="alternate" value="parent::place/note"/>
                        <param name="uri" value="$parameters?context-path || '/places/' || parent::place/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="placeName context">
                            <pb-popover>
                                <span slot="default">[[content]]</span>
                                <template slot="alternate">[[alternate]]</template>
                            </pb-popover>
                        </a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="parent::place" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-place">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><a href="places/[[ref]]" class="entity-place" data-cert="[[cert]]">[[content]]</a></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge place-badge"><pb-i18n key="entity.place">Lieu</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
<a href="places/[[ref]]" class="entity-tooltip-link"><pb-i18n key="entity.view-record">Voir la fiche</pb-i18n> &#x2192;</a>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-place" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge place-badge"><pb-i18n key="entity.place">Lieu</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Organization names: highlighted, linked to register, confidence-filterable
                     ============================================================ -->
                <elementSpec ident="orgName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register'" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="alternate" value="parent::org/note"/>
                        <param name="uri" value="$parameters?context-path || '/organizations/' || parent::org/@xml:id"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="orgName context">
                            <pb-popover>
                                <span slot="default">[[content]]</span>
                                <template slot="alternate">[[alternate]]</template>
                            </pb-popover>
                        </a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="parent::org" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-org">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><a href="organizations/[[ref]]" class="entity-org" data-cert="[[cert]]">[[content]]</a></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge org-badge"><pb-i18n key="entity.organization">Organisation</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
<a href="organizations/[[ref]]" class="entity-tooltip-link"><pb-i18n key="entity.view-record">Voir la fiche</pb-i18n> &#x2192;</a>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-org" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge org-badge"><pb-i18n key="entity.organization">Organisation</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     Title (work): highlighted only when @ref starts with #work-
                     Otherwise behaves as a regular title (inline).
                     ============================================================ -->
                <elementSpec ident="title" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="$parameters?mode='register-overview'" behaviour="inline"/>
                    <model predicate="starts-with(@ref, '#work-')" behaviour="pass-through" cssClass="entity-work">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-work" data-cert="[[cert]]" data-ref="[[ref]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge work-badge"><pb-i18n key="entity.work">Œuvre</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     rs: typed referencing string (event, technique, ...)
                     ============================================================ -->
                <elementSpec ident="rs" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="@type='event' and @ref" behaviour="pass-through" cssClass="entity-event">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-event" data-cert="[[cert]]" data-ref="[[ref]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge event-badge"><pb-i18n key="entity.event">Événement</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@type='event' and @cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-event" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge event-badge"><pb-i18n key="entity.event">Événement</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@type='event'" behaviour="inline" cssClass="entity-event"/>
                    <model predicate="@type='technique' and @ref" behaviour="pass-through" cssClass="entity-technique">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-technique" data-cert="[[cert]]" data-ref="[[ref]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge technique-badge"><pb-i18n key="entity.technique">Technique</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@type='technique' and @cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-technique" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge technique-badge"><pb-i18n key="entity.technique">Technique</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@type='technique'" behaviour="inline" cssClass="entity-technique"/>
                    <model predicate="@type and @cert" behaviour="pass-through" cssClass="entity-rs">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-rs" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     date: highlighted only when @ref or @cert is set (NER/linked).
                     Plain <date when="..."/> in the header keeps default rendering.
                     ============================================================ -->
                <elementSpec ident="date" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-date">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-date" data-cert="[[cert]]" data-ref="[[ref]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge date-badge"><pb-i18n key="entity.date">Date</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-date" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge date-badge"><pb-i18n key="entity.date">Date</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline"/>
                </elementSpec>

                <!-- ============================================================
                     objectName: highlighted, NER-tagged objects
                     ============================================================ -->
                <elementSpec ident="objectName" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-object">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-object" data-cert="[[cert]]" data-ref="[[ref]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge object-badge"><pb-i18n key="entity.object">Objet</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-object" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge object-badge"><pb-i18n key="entity.object">Objet</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline" cssClass="entity-object"/>
                </elementSpec>

                <!-- ============================================================
                     material: highlighted, NER-tagged materials (peinture, pigments, supports, etc.)
                     ============================================================ -->
                <elementSpec ident="material" mode="change">
                    <model output="print" behaviour="inline"/>
                    <model predicate="$parameters?display='browse' or $parameters?mode='breadcrumb' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="@ref" behaviour="pass-through" cssClass="entity-material">
                        <param name="content" value="."/>
                        <param name="ref" value="replace(@ref, '^#', '')"/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-material" data-cert="[[cert]]" data-ref="[[ref]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge material-badge"><pb-i18n key="entity.material">Matériau</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model predicate="@cert" behaviour="pass-through">
                        <param name="content" value="."/>
                        <param name="cert" value="string(@cert)"/>
                        <param name="resp" value="replace(string(@resp), '^#', '')"/>
                        <pb:template xmlns="" xml:space="preserve"><pb-popover theme="light-border"><span slot="default"><span class="entity-material" data-cert="[[cert]]">[[content]]</span></span><template slot="alternate">
<div class="entity-tooltip">
<span class="entity-badge material-badge"><pb-i18n key="entity.material">Matériau</pb-i18n></span>
<span class="entity-cert" data-cert="[[cert]]"><pb-i18n key="entity.confidence">Confiance</pb-i18n> : [[cert]]</span>
<span class="entity-resp" data-resp="[[resp]]">[[resp]]</span>
</div>
</template></pb-popover></pb:template>
                    </model>
                    <model behaviour="inline" cssClass="entity-material"/>
                </elementSpec>

                <!-- ============================================================
                     teiHeader: clean metadata rendering for right aside
                     ============================================================ -->
                <elementSpec ident="teiHeader" mode="change">
                    <model predicate="$parameters?view='metadata'" behaviour="block" cssClass="gs-metadata">
                        <param name="content" value="(fileDesc/titleStmt, fileDesc/sourceDesc, profileDesc/langUsage, encodingDesc/appInfo)"/>
                    </model>
                    <!-- Browse cards: titleStmt title + titleStmt author + sourceDesc date + sourceDesc pubPlace, wrapped in a clickable link to open the document -->
                    <model predicate="$parameters?display='browse'" behaviour="block" cssClass="gs-browse-card">
                        <param name="title" value="normalize-space(string-join(fileDesc/titleStmt/title//text(), ' '))"/>
                        <param name="author" value="normalize-space(string-join(fileDesc/titleStmt/author//text(), ' '))"/>
                        <param name="date" value="normalize-space(string-join(fileDesc/sourceDesc/bibl/date//text(), ' '))"/>
                        <param name="place" value="normalize-space(string-join(fileDesc/sourceDesc/bibl/pubPlace//text(), ' '))"/>
                        <param name="uri" value="$parameters?doc"/>
                        <pb:template xmlns="" xml:space="preserve"><a href="[[uri]]" class="gs-browse-card-link">
<h3 class="gs-browse-title">[[title]]</h3>
<div class="gs-browse-meta">
<span class="gs-browse-author">[[author]]</span>
<span class="gs-browse-place">[[place]]</span>
<span class="gs-browse-date">[[date]]</span>
</div>
</a></pb:template>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="inline">
                        <param name="content" value="fileDesc/titleStmt"/>
                    </model>
                </elementSpec>

                <!-- ============================================================
                     titleStmt: metadata heading + author list
                     ============================================================ -->
                <elementSpec ident="titleStmt" mode="change">
                    <model predicate="$parameters?view='metadata'" behaviour="block" cssClass="gs-meta-title">
                        <param name="content" value="(title, author)"/>
                    </model>
                    <model predicate="$parameters?mode='breadcrumb'" behaviour="inline">
                        <param name="content" value="title[1]"/>
                    </model>
                    <!-- Default (browse cards, search results, etc.): render as block so title/author appear -->
                    <model behaviour="block"/>
                </elementSpec>

                <!-- ============================================================
                     sourceDesc: source description (BnF, IIIF link)
                     ============================================================ -->
                <elementSpec ident="sourceDesc" mode="change">
                    <model predicate="$parameters?view='metadata'" behaviour="block" cssClass="gs-meta-source"/>
                    <model behaviour="block"/>
                </elementSpec>

                <!-- ============================================================
                     langUsage: declared languages of the source
                     ============================================================ -->
                <elementSpec ident="langUsage" mode="change">
                    <model predicate="$parameters?view='metadata'" behaviour="block" cssClass="gs-meta-langs"/>
                    <model behaviour="block"/>
                </elementSpec>

                <!-- ============================================================
                     appInfo: NER pipeline / OCR provenance
                     ============================================================ -->
                <elementSpec ident="appInfo" mode="change">
                    <model predicate="$parameters?view='metadata'" behaviour="block" cssClass="gs-meta-pipeline"/>
                    <model behaviour="block"/>
                </elementSpec>

                <!-- ============================================================
                     body: when view=notes, render as a list of marginal notes
                     for the current page; otherwise transparent block
                     ============================================================ -->
                <elementSpec ident="body" mode="change">
                    <model predicate="$parameters?view='notes'" behaviour="list" cssClass="gs-notes-list">
                        <param name="content" value=".//note[@type='MarginTextZone']"/>
                        <param name="type" value="'unordered'"/>
                    </model>
                    <model behaviour="block"/>
                </elementSpec>

            </schemaSpec>
        </body>
    </text>
</TEI>
